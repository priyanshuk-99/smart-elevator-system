 */

// ==========================================
// 1. ENUMS & DOMAIN TYPES
// ==========================================

enum Direction {
    UP, DOWN, IDLE;

    public static Direction fromFloors(int fromFloor, int toFloor) {
        if (toFloor > fromFloor) return UP;
        if (toFloor < fromFloor) return DOWN;
        return IDLE;
    }
}

enum TrafficProfile {
    UP_PEAK("Morning Up-Peak (Lobby -> Upper Floors)"),
    DOWN_PEAK("Evening Down-Peak (Upper Floors -> Lobby)"),
    INTER_FLOOR("Inter-Floor Balanced (Random)");

    private final String label;
    TrafficProfile(String label) { this.label = label; }
    public String getLabel() { return label; }
}

enum ElevatorEventType {
    STATE_CHANGED, FLOOR_CHANGED, DOORS_OPENED, DOORS_CLOSED,
    PASSENGER_BOARDED, PASSENGER_ALIGHTED, OVERLOAD_WARNING
}

