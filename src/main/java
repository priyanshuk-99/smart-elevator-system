// ==========================================
// 5. STATE PATTERN (ELEVATOR FSM)
// ==========================================

interface ElevatorState {
    void onTick(Elevator elevator, long currentTick);
    String getStateName();
}

class IdleState implements ElevatorState {
    @Override
    public void onTick(Elevator elevator, long currentTick) {
        elevator.setDirection(Direction.IDLE);

        if (elevator.hasTargetFloor(elevator.getCurrentFloor())) {
            elevator.setState(new DoorsOpenState(), currentTick);
            return;
        }

        if (elevator.hasTargetsAbove()) {
            elevator.setDirection(Direction.UP);
            elevator.setState(new MovingUpState(), currentTick);
        } else if (elevator.hasTargetsBelow()) {
            elevator.setDirection(Direction.DOWN);
            elevator.setState(new MovingDownState(), currentTick);
        }
    }

    @Override
    public String getStateName() { return "IDLE"; }
}

class MovingUpState implements ElevatorState {
    @Override
    public void onTick(Elevator elevator, long currentTick) {
        elevator.setDirection(Direction.UP);

        if (elevator.getCurrentFloor() < elevator.getMaxFloor()) {
            elevator.stepFloor(1, currentTick);
        }

        if (elevator.hasTargetFloor(elevator.getCurrentFloor())) {
            elevator.setState(new DoorsOpenState(), currentTick);
            return;
        }

        if (!elevator.hasTargetsAbove()) {
            if (elevator.hasTargetsBelow()) {
                elevator.setDirection(Direction.DOWN);
                elevator.setState(new MovingDownState(), currentTick);
            } else {
                elevator.setDirection(Direction.IDLE);
                elevator.setState(new IdleState(), currentTick);
            }
        }
    }

    @Override
    public String getStateName() { return "MOVING_UP"; }
}

class MovingDownState implements ElevatorState {
    @Override
    public void onTick(Elevator elevator, long currentTick) {
        elevator.setDirection(Direction.DOWN);

        if (elevator.getCurrentFloor() > elevator.getMinFloor()) {
            elevator.stepFloor(-1, currentTick);
        }

        if (elevator.hasTargetFloor(elevator.getCurrentFloor())) {
            elevator.setState(new DoorsOpenState(), currentTick);
            return;
        }

        if (!elevator.hasTargetsBelow()) {
            if (elevator.hasTargetsAbove()) {
                elevator.setDirection(Direction.UP);
                elevator.setState(new MovingUpState(), currentTick);
            } else {
                elevator.setDirection(Direction.IDLE);
                elevator.setState(new IdleState(), currentTick);
            }
        }
    }

    @Override
    public String getStateName() { return "MOVING_DOWN"; }
}

class DoorsOpenState implements ElevatorState {
    private int countdown = 2; // Doors stay open for 2 ticks

    @Override
    public void onTick(Elevator elevator, long currentTick) {
        if (countdown == 2) {
            elevator.fireEvent(ElevatorEventType.DOORS_OPENED, currentTick, "Doors opened at floor " + elevator.getCurrentFloor(), null);
            elevator.disembarkPassengers(currentTick);
        }

        countdown--;

        if (countdown <= 0) {
            elevator.fireEvent(ElevatorEventType.DOORS_CLOSED, currentTick, "Doors closed at floor " + elevator.getCurrentFloor(), null);

            Direction dir = elevator.getDirection();
            if (dir == Direction.UP && elevator.hasTargetsAbove()) {
                elevator.setState(new MovingUpState(), currentTick);
            } else if (dir == Direction.DOWN && elevator.hasTargetsBelow()) {
                elevator.setState(new MovingDownState(), currentTick);
            } else if (elevator.hasTargetsAbove()) {
                elevator.setDirection(Direction.UP);
                elevator.setState(new MovingUpState(), currentTick);
            } else if (elevator.hasTargetsBelow()) {
                elevator.setDirection(Direction.DOWN);
                elevator.setState(new MovingDownState(), currentTick);
            } else {
                elevator.setDirection(Direction.IDLE);
                elevator.setState(new IdleState(), currentTick);
            }
        }
    }

    @Override
    public String getStateName() { return "DOORS_OPEN"; }
}

