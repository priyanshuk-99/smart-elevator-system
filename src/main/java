class MetricsCollector implements ElevatorObserver {
    private final String strategyName;
    private final String profileName;
    private final List<Passenger> completed = new ArrayList<>();
    private long totalTicks = 0;
    private long totalDistance = 0;

    public MetricsCollector(String strategyName, String profileName) {
        this.strategyName = strategyName;
        this.profileName = profileName;
    }

    @Override
    public synchronized void onElevatorEvent(ElevatorEvent event) {
        if (event.getType() == ElevatorEventType.PASSENGER_ALIGHTED && event.getPayload() instanceof Passenger) {
            completed.add((Passenger) event.getPayload());
        }
    }

    public synchronized void finalizeRun(long ticks, List<Elevator> elevators) {
        this.totalTicks = ticks;
        this.totalDistance = elevators.stream().mapToLong(Elevator::getTotalDistanceTraveled).sum();
    }

    public String getStrategyName() { return strategyName; }
    public String getProfileName() { return profileName; }
    public int getCompletedCount() { return completed.size(); }
    public long getTotalTicks() { return totalTicks; }
    public long getTotalDistance() { return totalDistance; }

    public double getAverageWait() {
        return completed.stream().mapToLong(Passenger::getWaitTime).average().orElse(0.0);
    }

    public long getMaxWait() {
        return completed.stream().mapToLong(Passenger::getWaitTime).max().orElse(0);
    }

    public double getPercentile95Wait() {
        if (completed.isEmpty()) return 0.0;
        List<Long> list = completed.stream().map(Passenger::getWaitTime).sorted().collect(Collectors.toList());
        int idx = (int) Math.ceil(0.95 * list.size()) - 1;
        return list.get(Math.max(0, Math.min(idx, list.size() - 1)));
    }

    public double getAverageTransit() {
        return completed.stream().mapToLong(Passenger::getTransitTime).average().orElse(0.0);
    }

    public double getEstimatedEnergyKWh() {
        return totalDistance * 0.5;
    }
}

class SimulationEngine {
    private final Building building;
    private final ElevatorController controller;
    private final MetricsCollector metrics;
    private final List<Passenger> pendingQueue;
    private long tick = 0;

    public SimulationEngine(Building building, ElevatorController controller,
                            MetricsCollector metrics, List<Passenger> scenario) {
        this.building = building;
        this.controller = controller;
        this.metrics = metrics;
        this.pendingQueue = new ArrayList<>(scenario);

        for (Elevator e : building.getElevators()) {
            e.addObserver(metrics);
        }
    }

    public Building getBuilding() { return building; }
    public ElevatorController getController() { return controller; }
    public MetricsCollector getMetrics() { return metrics; }
    public long getTick() { return tick; }

    public void runUntilDone(long maxTicks) {
        while (tick < maxTicks && !isFinished()) {
            step();
        }
        metrics.finalizeRun(tick, building.getElevators());
    }

    public void step() {
        tick++;

        // 1. Spawn passengers whose arrival time has arrived
        Iterator<Passenger> it = pendingQueue.iterator();
        while (it.hasNext()) {
            Passenger p = it.next();
            if (p.getSpawnTick() <= tick) {
                building.getFloor(p.getSourceFloor()).addWaitingPassenger(p);
                controller.dispatch(new ExternalRequest(p.getSourceFloor(), p.getDesiredDirection(), tick), tick);
                it.remove();
            }
        }

        // 2. Advance elevators and handle passenger boarding
        for (Elevator e : building.getElevators()) {
            e.tick(tick);
            controller.processBoarding(e, tick);
        }
    }

    public boolean isFinished() {
        boolean noPending = pendingQueue.isEmpty();
        boolean noWaiting = building.getFloors().stream().allMatch(f -> f.getWaitingPassengers().isEmpty());
        boolean noOnboard = building.getElevators().stream().allMatch(e -> e.getPassengerCount() == 0);
        boolean allResting = building.getElevators().stream().allMatch(e -> e.getTargetFloors().isEmpty() && e.getDirection() == Direction.IDLE);
        return noPending && noWaiting && noOnboard && allResting;
    }
}

// ==========================================
// 10. SCENARIO GENERATOR
// ==========================================

class ScenarioGenerator {
    public static List<Passenger> generate(long seed, int count, int minFloor, int maxFloor,
                                           TrafficProfile profile, long maxSpawnTick) {
        Random rand = new Random(seed);
        List<Passenger> list = new ArrayList<>();

        for (int i = 1; i <= count; i++) {
            String id = String.format("PAX-%03d", i);
            long spawn = (long) (rand.nextDouble() * maxSpawnTick);
            double weight = Math.round((60.0 + rand.nextDouble() * 30.0) * 10.0) / 10.0;
            int src, dst;

            if (profile == TrafficProfile.UP_PEAK) {
                src = (rand.nextDouble() < 0.8) ? minFloor : (minFloor + rand.nextInt(maxFloor - minFloor + 1));
                dst = (src == minFloor) ? (minFloor + 1 + rand.nextInt(maxFloor - minFloor)) : (minFloor + rand.nextInt(maxFloor - minFloor + 1));
            } else if (profile == TrafficProfile.DOWN_PEAK) {
                src = (rand.nextDouble() < 0.8) ? (minFloor + 1 + rand.nextInt(maxFloor - minFloor)) : (minFloor + rand.nextInt(maxFloor - minFloor + 1));
                dst = (src != minFloor && rand.nextDouble() < 0.8) ? minFloor : (minFloor + rand.nextInt(maxFloor - minFloor + 1));
            } else {
                src = minFloor + rand.nextInt(maxFloor - minFloor + 1);
                dst = minFloor + rand.nextInt(maxFloor - minFloor + 1);
            }

            while (dst == src) {
                dst = minFloor + rand.nextInt(maxFloor - minFloor + 1);
            }

            list.add(new Passenger(id, src, dst, weight, spawn));
        }

        list.sort(Comparator.comparingLong(Passenger::getSpawnTick));
        return list;
    }
}

