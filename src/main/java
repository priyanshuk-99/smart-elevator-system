public class SmartElevatorSimulator {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            printHeader();
            System.out.println("SELECT RUN MODE:");
            System.out.println("  [1] Interactive Mode (Enter custom passengers live + ASCII Shaft visual)");
            System.out.println("  [2] Automated Scientific Benchmark (FCFS vs. Nearest-Car vs. SCAN)");
            System.out.println("  [3] Exit");
            System.out.print("\nEnter your choice (1-3): ");

            String choice = scanner.nextLine().trim();

            if (choice.equals("1")) {
                runInteractiveMode(scanner);
            } else if (choice.equals("2")) {
                runAutomatedBenchmark();
                System.out.println("\nPress Enter to return to main menu...");
                scanner.nextLine();
            } else if (choice.equals("3")) {
                System.out.println("\nExiting Smart Elevator Simulator. Goodbye!");
                break;
            } else {
                System.out.println("Invalid selection. Please enter 1, 2, or 3.");
            }
        }
    }

    /**
     * Interactive Mode: Allows user to manually enter passenger requests,
     * swap algorithms at runtime, step through ticks, and view ASCII shaft visuals.
     */
    private static void runInteractiveMode(Scanner scanner) {
        int minFloor = 0;
        int maxFloor = 9;
        int numElevators = 3;
        double capacityKg = 650.0;

        Building building = new Building(minFloor, maxFloor, numElevators, capacityKg);
        SchedulingStrategy currentStrategy = new ScanStrategy();
        ElevatorController controller = new ElevatorController(building, currentStrategy);
        MetricsCollector metrics = new MetricsCollector("Interactive", "Custom User Inputs");
        SimulationEngine engine = new SimulationEngine(building, controller, metrics, new ArrayList<>());

        int passengerCounter = 1;

        System.out.println("\n================================================================================");
        System.out.println("       INTERACTIVE ELEVATOR SIMULATION STARTED (10 Floors, 3 Elevators)");
        System.out.println("================================================================================");
        System.out.println("Initial Strategy: " + controller.getStrategy().getStrategyName());

        while (true) {
            printAsciiBuilding(building, engine.getTick(), controller.getStrategy());

            System.out.println("\nINTERACTIVE COMMANDS:");
            System.out.println("  [A] Add Passenger (Enter Source, Destination, Weight)");
            System.out.println("  [S] Step 1 Tick");
            System.out.println("  [T] Step 5 Ticks");
            System.out.println("  [R] Run until all pending passengers are delivered");
            System.out.println("  [C] Change Scheduling Strategy at runtime");
            System.out.println("  [M] View Metrics Summary");
            System.out.println("  [Q] Quit back to Main Menu");
            System.out.print("\nCommand: ");

            String cmd = scanner.nextLine().trim().toUpperCase();

            if (cmd.equals("Q")) {
                break;
            } else if (cmd.equals("A")) {
                // User enters custom passenger details
                try {
                    System.out.print("Enter passenger name/ID (e.g. Alice, P" + passengerCounter + "): ");
                    String name = scanner.nextLine().trim();
                    if (name.isEmpty()) name = "PAX-" + passengerCounter;

                    System.out.print("Enter Source Floor (" + minFloor + " to " + maxFloor + "): ");
                    int src = Integer.parseInt(scanner.nextLine().trim());
                    if (src < minFloor || src > maxFloor) {
                        System.out.println("[Error] Floor must be between " + minFloor + " and " + maxFloor);
                        continue;
                    }

                    System.out.print("Enter Destination Floor (" + minFloor + " to " + maxFloor + "): ");
                    int dst = Integer.parseInt(scanner.nextLine().trim());
                    if (dst < minFloor || dst > maxFloor) {
                        System.out.println("[Error] Floor must be between " + minFloor + " and " + maxFloor);
                        continue;
                    }
                    if (dst == src) {
                        System.out.println("[Error] Source and Destination floors cannot be the same!");
                        continue;
                    }

                    System.out.print("Enter Passenger Weight in kg [Default 70]: ");
                    String wInput = scanner.nextLine().trim();
                    double weight = wInput.isEmpty() ? 70.0 : Double.parseDouble(wInput);

                    Passenger newPax = new Passenger(name, src, dst, weight, engine.getTick());
                    passengerCounter++;

                    // Add passenger to the source floor
                    building.getFloor(src).addWaitingPassenger(newPax);

                    // Issue hall call to elevator controller
                    ExternalRequest request = new ExternalRequest(src, newPax.getDesiredDirection(), engine.getTick());
                    Elevator assignedElevator = controller.dispatch(request, engine.getTick());

                    System.out.printf("%n>> [SUCCESS] Passenger '%s' (%.1f kg) placed at Floor %d heading to Floor %d!%n",
                            name, weight, src, dst);
                    System.out.printf(">> [DISPATCH] Strategy '%s' assigned Elevator #%d to serve this request.%n%n",
                            controller.getStrategy().getStrategyName(), assignedElevator.getId());

                } catch (NumberFormatException e) {
                    System.out.println("[Error] Please enter valid numeric values for floors and weight.");
                }
            } else if (cmd.equals("S")) {
                engine.step();
            } else if (cmd.equals("T")) {
                for (int i = 0; i < 5; i++) {
                    engine.step();
                }
            } else if (cmd.equals("R")) {
                System.out.println("\nRunning until all passengers reach their destinations...");
                int maxLoops = 200;
                int count = 0;
                while (!engine.isFinished() && count < maxLoops) {
                    engine.step();
                    count++;
                }
                System.out.println(">> Simulation reached steady state in " + count + " ticks.");
            } else if (cmd.equals("C")) {
                System.out.println("\nSelect New Scheduling Strategy:");
                System.out.println("  1. FCFS (First-Come, First-Served)");
                System.out.println("  2. Nearest-Car (Shortest Seek Time / SSTF)");
                System.out.println("  3. SCAN / LOOK (Elevator Sweep)");
                System.out.print("Choice: ");
                String stratChoice = scanner.nextLine().trim();
                if (stratChoice.equals("1")) {
                    controller.setStrategy(new FCFSStrategy());
                } else if (stratChoice.equals("2")) {
                    controller.setStrategy(new NearestCarStrategy());
                } else if (stratChoice.equals("3")) {
                    controller.setStrategy(new ScanStrategy());
                } else {
                    System.out.println("Invalid strategy selection.");
                }
            } else if (cmd.equals("M")) {
                System.out.println("\n--- CURRENT METRICS ---");
                System.out.printf(" Passengers Completed : %d%n", metrics.getCompletedCount());
                System.out.printf(" Avg Wait Time        : %.2f ticks%n", metrics.getAverageWait());
                System.out.printf(" Max Wait Time        : %d ticks%n", metrics.getMaxWait());
                System.out.printf(" Total Distance       : %d floors%n",
                        building.getElevators().stream().mapToLong(Elevator::getTotalDistanceTraveled).sum());
                System.out.printf(" Est. Energy Spent    : %.1f kWh%n",
                        building.getElevators().stream().mapToLong(Elevator::getTotalDistanceTraveled).sum() * 0.5);
                System.out.println("-----------------------");
            } else {
                System.out.println("Unknown command. Enter A, S, T, R, C, M, or Q.");
            }
        }
    }

    /**
     * Renders a real-time ASCII representation of building elevator shafts,
     * car states, loads, and floor queues.
     */
    private static void printAsciiBuilding(Building building, long tick, SchedulingStrategy strategy) {
        System.out.println("\n================================================================================");
        System.out.printf(" BUILDING SHAFTS [Tick %4d] | Active Strategy: %s%n", tick, strategy.getStrategyName());
        System.out.println("================================================================================");
        System.out.println(" Floor |   Elevator 1   |   Elevator 2   |   Elevator 3   | Hall Waiting Queue");
        System.out.println("-------+----------------+----------------+----------------+---------------------");

        List<Elevator> elevs = building.getElevators();

        for (int f = building.getMaxFloor(); f >= building.getMinFloor(); f--) {
            StringBuilder sb = new StringBuilder();
            sb.append(String.format("  %2d   |", f));

            for (Elevator e : elevs) {
                if (e.getCurrentFloor() == f) {
                    String stateSymbol;
                    if (e.getState() instanceof DoorsOpenState) {
                        stateSymbol = "[DOORS OPEN]";
                    } else if (e.getDirection() == Direction.UP) {
                        stateSymbol = "[ ▲ UP  " + e.getPassengerCount() + "p]";
                    } else if (e.getDirection() == Direction.DOWN) {
                        stateSymbol = "[ ▼ DOWN" + e.getPassengerCount() + "p]";
                    } else {
                        stateSymbol = "[  IDLE " + e.getPassengerCount() + "p]";
                    }
                    sb.append(String.format(" %-14s |", stateSymbol));
                } else {
                    sb.append("       |        |");
                }
            }

            // Show waiting passengers on this floor
            Floor fl = building.getFloor(f);
            List<Passenger> waiting = fl.getWaitingPassengers();
            if (!waiting.isEmpty()) {
                sb.append(" ");
                for (Passenger p : waiting) {
                    sb.append(String.format("[%s->%d] ", p.getId(), p.getDestinationFloor()));
                }
            }
            System.out.println(sb.toString());
        }

        System.out.println("-------+----------------+----------------+----------------+---------------------");
        for (Elevator e : elevs) {
            System.out.printf("Car #%d: %-10s | Load: %d/8 pax (%.1f/%.0f kg) | Targets: %s%n",
                    e.getId(), e.getState().getStateName(), e.getPassengerCount(),
                    e.getCurrentWeightKg(), e.getMaxCapacityKg(), e.getTargetFloors());
        }
        System.out.println("================================================================================");
    }

    /**
     * Automated Batch Benchmark Suite across traffic profiles.
     */
    private static void runAutomatedBenchmark() {
        int minFloor = 0;
        int maxFloor = 9;
        int numElevators = 3;
        double capacityKg = 650.0;
        long seed = 42L;
        int passengerCount = 50;
        long maxSpawnTick = 100;

        System.out.printf("%nRunning Automated Benchmark: %d Floors | %d Elevators | %.0f kg Limit | %d Passengers | Seed=%d%n%n",
                (maxFloor - minFloor + 1), numElevators, capacityKg, passengerCount, seed);

        SchedulingStrategy[] strategies = {
                new FCFSStrategy(),
                new NearestCarStrategy(),
                new ScanStrategy()
        };

        TrafficProfile[] profiles = {
                TrafficProfile.UP_PEAK,
                TrafficProfile.INTER_FLOOR,
                TrafficProfile.DOWN_PEAK
        };

        List<MetricsCollector> allResults = new ArrayList<>();

        for (TrafficProfile profile : profiles) {
            System.out.println("\n[Testing Profile: " + profile.getLabel() + "]");

            List<Passenger> baseScenario = ScenarioGenerator.generate(seed, passengerCount, minFloor, maxFloor, profile, maxSpawnTick);

            for (SchedulingStrategy strategy : strategies) {
                Building b = new Building(minFloor, maxFloor, numElevators, capacityKg);
                ElevatorController ctrl = new ElevatorController(b, strategy);
                MetricsCollector collector = new MetricsCollector(strategy.getStrategyName(), profile.getLabel());

                List<Passenger> runList = new ArrayList<>();
                for (Passenger p : baseScenario) {
                    runList.add(new Passenger(p.getId(), p.getSourceFloor(), p.getDestinationFloor(), p.getWeightKg(), p.getSpawnTick()));
                }

                SimulationEngine engine = new SimulationEngine(b, ctrl, collector, runList);
                long startMs = System.currentTimeMillis();
                engine.runUntilDone(2000);
                long tookMs = System.currentTimeMillis() - startMs;

                allResults.add(collector);

                System.out.printf("  -> %-22s | Done in %4d ticks (%2d ms) | Avg Wait: %5.2f | Max Wait: %3d | Distance: %3d floors%n",
                        strategy.getStrategyName().split(" ")[0],
                        collector.getTotalTicks(),
                        tookMs,
                        collector.getAverageWait(),
                        collector.getMaxWait(),
                        collector.getTotalDistance());
            }
        }

        printResultsTable(allResults);
        exportSummaryCsv(allResults, "elevator_benchmark_summary.csv");
        printVivaGuide();
    }

    private static void printResultsTable(List<MetricsCollector> list) {
        System.out.println("\n==========================================================================================================");
        System.out.println("                                 FINAL BENCHMARK COMPARISON TABLE                                         ");
        System.out.println("==========================================================================================================");
        System.out.printf("%-16s | %-16s | %-8s | %-9s | %-8s | %-9s | %-9s | %-10s%n",
                "Strategy", "Traffic Profile", "Avg Wait", "95% Wait", "Max Wait", "Avg Trip", "Distance", "Est Energy");
        System.out.println("----------------------------------------------------------------------------------------------------------");

        for (MetricsCollector m : list) {
            String shortStrat = m.getStrategyName().split(" ")[0];
            String shortProf = m.getProfileName().split(" ")[0];
            System.out.printf("%-16s | %-16s | %8.2f | %9.2f | %8d | %9.2f | %9d | %8.1f kWh%n",
                    shortStrat, shortProf,
                    m.getAverageWait(),
                    m.getPercentile95Wait(),
                    m.getMaxWait(),
                    m.getAverageTransit(),
                    m.getTotalDistance(),
                    m.getEstimatedEnergyKWh());
        }
        System.out.println("==========================================================================================================\n");
    }

    private static void exportSummaryCsv(List<MetricsCollector> list, String filename) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(filename))) {
            writer.write("Strategy,TrafficProfile,PassengersServed,TotalTicks,AvgWaitTime,95thPercentileWait,MaxWaitTime,AvgTransitTime,TotalDistanceFloors,EnergyKWh\n");
            for (MetricsCollector m : list) {
                writer.write(String.format("\"%s\",\"%s\",%d,%d,%.2f,%.2f,%d,%.2f,%d,%.2f\n",
                        m.getStrategyName(), m.getProfileName(), m.getCompletedCount(), m.getTotalTicks(),
                        m.getAverageWait(), m.getPercentile95Wait(), m.getMaxWait(), m.getAverageTransit(),
                        m.getTotalDistance(), m.getEstimatedEnergyKWh()));
            }
            System.out.println(">> [EXPORT] Results exported to CSV: " + new File(filename).getAbsolutePath());
        } catch (IOException e) {
            System.err.println("CSV export failed: " + e.getMessage());
        }
    }

