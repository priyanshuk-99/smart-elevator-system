class Passenger {
    private final String id;
    private final int sourceFloor;
    private final int destinationFloor;
    private final double weightKg;
    private final long spawnTick;
    private long pickupTick = -1;
    private long dropoffTick = -1;

    public Passenger(String id, int sourceFloor, int destinationFloor, double weightKg, long spawnTick) {
        if (sourceFloor == destinationFloor) {
            throw new IllegalArgumentException("Source and destination floor cannot be identical.");
        }
        this.id = id;
        this.sourceFloor = sourceFloor;
        this.destinationFloor = destinationFloor;
        this.weightKg = weightKg;
        this.spawnTick = spawnTick;
    }

    public String getId() { return id; }
    public int getSourceFloor() { return sourceFloor; }
    public int getDestinationFloor() { return destinationFloor; }
    public double getWeightKg() { return weightKg; }
    public long getSpawnTick() { return spawnTick; }
    public long getPickupTick() { return pickupTick; }
    public long getDropoffTick() { return dropoffTick; }

    public synchronized void recordPickup(long tick) { this.pickupTick = tick; }
    public synchronized void recordDropoff(long tick) { this.dropoffTick = tick; }

    public Direction getDesiredDirection() {
        return Direction.fromFloors(sourceFloor, destinationFloor);
    }

    public long getWaitTime() {
        return pickupTick < 0 ? -1 : (pickupTick - spawnTick);
    }

    public long getTransitTime() {
        return (dropoffTick < 0 || pickupTick < 0) ? -1 : (dropoffTick - pickupTick);
    }

    public long getTotalTurnaroundTime() {
        return dropoffTick < 0 ? -1 : (dropoffTick - spawnTick);
    }
}

abstract class Request {
    private static final AtomicLong ID_GEN = new AtomicLong(1);
    private final long requestId;
    private final int targetFloor;
    private final long requestTime;

    public Request(int targetFloor, long requestTime) {
        this.requestId = ID_GEN.getAndIncrement();
        this.targetFloor = targetFloor;
        this.requestTime = requestTime;
    }

    public long getRequestId() { return requestId; }
    public int getTargetFloor() { return targetFloor; }
    public long getRequestTime() { return requestTime; }
    public abstract String getRequestType();
}

class ExternalRequest extends Request {
    private final Direction direction;

    public ExternalRequest(int sourceFloor, Direction direction, long requestTime) {
        super(sourceFloor, requestTime);
        this.direction = direction;
    }

    public Direction getDirection() { return direction; }
    public int getSourceFloor() { return getTargetFloor(); }

    @Override
    public String getRequestType() { return "EXTERNAL_" + direction; }
}

class InternalRequest extends Request {
    private final String passengerId;

    public InternalRequest(int destinationFloor, String passengerId, long requestTime) {
        super(destinationFloor, requestTime);
        this.passengerId = passengerId;
    }

    public String getPassengerId() { return passengerId; }

    @Override
    public String getRequestType() { return "INTERNAL"; }
}

