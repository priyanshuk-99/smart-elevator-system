// 6. ELEVATOR MODEL (ENCAPSULATION)
// ==========================================

class Elevator {
    private final int id;
    private final int minFloor;
    private final int maxFloor;
    private final double maxCapacityKg;

    private int currentFloor;
    private Direction direction;
    private ElevatorState state;
    private double currentWeightKg;
    private long totalDistanceTraveled;

    private final TreeSet<Integer> targetFloors = new TreeSet<>();
    private final List<Passenger> onboardPassengers = new ArrayList<>();
    private final List<ElevatorObserver> observers = new CopyOnWriteArrayList<>();

    public Elevator(int id, int minFloor, int maxFloor, double maxCapacityKg, int initialFloor) {
        this.id = id;
        this.minFloor = minFloor;
        this.maxFloor = maxFloor;
        this.maxCapacityKg = maxCapacityKg;
        this.currentFloor = initialFloor;
        this.direction = Direction.IDLE;
        this.state = new IdleState();
        this.currentWeightKg = 0.0;
        this.totalDistanceTraveled = 0;
    }

    public int getId() { return id; }
    public int getMinFloor() { return minFloor; }
    public int getMaxFloor() { return maxFloor; }
    public double getMaxCapacityKg() { return maxCapacityKg; }

    public synchronized int getCurrentFloor() { return currentFloor; }
    public synchronized Direction getDirection() { return direction; }
    public synchronized void setDirection(Direction direction) { this.direction = direction; }
    public synchronized ElevatorState getState() { return state; }
    public synchronized double getCurrentWeightKg() { return currentWeightKg; }
    public synchronized long getTotalDistanceTraveled() { return totalDistanceTraveled; }
    public synchronized int getPassengerCount() { return onboardPassengers.size(); }
    public synchronized List<Passenger> getOnboardPassengers() { return new ArrayList<>(onboardPassengers); }
    public synchronized Set<Integer> getTargetFloors() { return Collections.unmodifiableSet(new TreeSet<>(targetFloors)); }

    public void addObserver(ElevatorObserver observer) { observers.add(observer); }

    public void fireEvent(ElevatorEventType type, long currentTick, String message, Object payload) {
        ElevatorEvent event = new ElevatorEvent(type, id, currentFloor, currentTick, message, payload);
        for (ElevatorObserver obs : observers) {
            obs.onElevatorEvent(event);
        }
    }

    public synchronized void setState(ElevatorState newState, long currentTick) {
        this.state = newState;
        fireEvent(ElevatorEventType.STATE_CHANGED, currentTick, "State -> " + newState.getStateName(), newState);
    }

    public synchronized void addTargetFloor(int floor, long currentTick) {
        if (floor < minFloor || floor > maxFloor) {
            throw new InvalidFloorException(floor, minFloor, maxFloor);
        }
        targetFloors.add(floor);
    }

    public synchronized void removeTargetFloor(int floor) { targetFloors.remove(floor); }
    public synchronized boolean hasTargetFloor(int floor) { return targetFloors.contains(floor); }
    public synchronized boolean hasTargetsAbove() { return targetFloors.higher(currentFloor) != null; }
    public synchronized boolean hasTargetsBelow() { return targetFloors.lower(currentFloor) != null; }

    public synchronized void stepFloor(int delta, long currentTick) {
        int nextFloor = currentFloor + delta;
        if (nextFloor < minFloor || nextFloor > maxFloor) {
            throw new InvalidFloorException(nextFloor, minFloor, maxFloor);
        }
        this.currentFloor = nextFloor;
        this.totalDistanceTraveled += Math.abs(delta);
        fireEvent(ElevatorEventType.FLOOR_CHANGED, currentTick, "Floor " + currentFloor, currentFloor);
    }

    public synchronized void boardPassenger(Passenger passenger, long currentTick) throws OverloadException {
        if (currentWeightKg + passenger.getWeightKg() > maxCapacityKg) {
            fireEvent(ElevatorEventType.OVERLOAD_WARNING, currentTick,
                    "Overload prevented passenger " + passenger.getId() + " from boarding", passenger);
            throw new OverloadException(id, currentWeightKg, passenger.getWeightKg(), maxCapacityKg);
        }

        onboardPassengers.add(passenger);
        currentWeightKg += passenger.getWeightKg();
        passenger.recordPickup(currentTick);
        addTargetFloor(passenger.getDestinationFloor(), currentTick);

        fireEvent(ElevatorEventType.PASSENGER_BOARDED, currentTick,
                "Passenger " + passenger.getId() + " boarded for floor " + passenger.getDestinationFloor(), passenger);
    }

    public synchronized List<Passenger> disembarkPassengers(long currentTick) {
        List<Passenger> alighting = new ArrayList<>();
        Iterator<Passenger> it = onboardPassengers.iterator();
        while (it.hasNext()) {
            Passenger p = it.next();
            if (p.getDestinationFloor() == currentFloor) {
                p.recordDropoff(currentTick);
                currentWeightKg = Math.max(0, currentWeightKg - p.getWeightKg());
                alighting.add(p);
                it.remove();

                fireEvent(ElevatorEventType.PASSENGER_ALIGHTED, currentTick,
                        "Passenger " + p.getId() + " disembarked at floor " + currentFloor, p);
            }
        }
        removeTargetFloor(currentFloor);
        return alighting;
    }

    public synchronized void tick(long currentTick) {
        state.onTick(this, currentTick);
    }
}

// ==========================================
// 7. STRATEGY PATTERN (SCHEDULING ALGORITHMS)
// ==========================================

interface SchedulingStrategy {
    Elevator selectElevator(List<Elevator> elevators, ExternalRequest request, int totalFloors);
    String getStrategyName();
}

/**
 * 1. FCFS Strategy: Naive baseline dispatching requests based on lowest pending workload.
 */
class FCFSStrategy implements SchedulingStrategy {
    @Override
    public Elevator selectElevator(List<Elevator> elevators, ExternalRequest request, int totalFloors) {
        return elevators.stream()
                .min(Comparator.comparingInt((Elevator e) -> e.getTargetFloors().size() + e.getPassengerCount())
                        .thenComparingInt(Elevator::getId))
                .orElse(elevators.get(0));
    }

    @Override
    public String getStrategyName() { return "FCFS (First-Come, First-Served)"; }
}

/**
 * 2. Nearest-Car Strategy (SSTF): Minimizes instantaneous floor distance.
 * Note for viva: Highly responsive in light traffic, but susceptible to starvation on distant floors.
 */
class NearestCarStrategy implements SchedulingStrategy {
    @Override
    public Elevator selectElevator(List<Elevator> elevators, ExternalRequest request, int totalFloors) {
        Elevator best = null;
        double bestScore = Double.MAX_VALUE;
        int reqFloor = request.getSourceFloor();
        Direction reqDir = request.getDirection();

        for (Elevator e : elevators) {
            int dist = Math.abs(e.getCurrentFloor() - reqFloor);
            Direction elevDir = e.getDirection();
            double score = dist;

            if (elevDir == Direction.IDLE) {
                // Optimal candidate
            } else if (elevDir == reqDir && ((elevDir == Direction.UP && reqFloor >= e.getCurrentFloor()) ||
                                             (elevDir == Direction.DOWN && reqFloor <= e.getCurrentFloor()))) {
                score += (e.getTargetFloors().size() * 0.5);
            } else {
                score += (totalFloors * 1.5) + e.getTargetFloors().size();
            }

            if (score < bestScore) {
                bestScore = score;
                best = e;
            }
        }
        return best != null ? best : elevators.get(0);
    }

    @Override
    public String getStrategyName() { return "Nearest-Car (SSTF)"; }
}

/**
 * 3. SCAN / LOOK Strategy (The Elevator Algorithm):
 * Sweeps in current direction picking up aligned requests before reversing. Prevents starvation.
 */
class ScanStrategy implements SchedulingStrategy {
    @Override
    public Elevator selectElevator(List<Elevator> elevators, ExternalRequest request, int totalFloors) {
        Elevator best = null;
        double bestFom = Double.MAX_VALUE;
        int reqFloor = request.getSourceFloor();
        Direction reqDir = request.getDirection();

        for (Elevator e : elevators) {
            int currentFloor = e.getCurrentFloor();
            Direction elevDir = e.getDirection();
            int dist = Math.abs(currentFloor - reqFloor);
            double fom;

            if (elevDir == reqDir) {
                if ((elevDir == Direction.UP && currentFloor <= reqFloor) ||
                    (elevDir == Direction.DOWN && currentFloor >= reqFloor)) {
                    fom = dist; // Top priority: on current sweep
                } else {
                    fom = dist + totalFloors * 2.0;
                }
            } else if (elevDir == Direction.IDLE) {
                fom = dist + 2.0; // Ready idle car
            } else {
                fom = dist + totalFloors * 1.5; // Moving away / reverse needed
            }

            if (fom < bestFom) {
                bestFom = fom;
                best = e;
            }
        }
        return best != null ? best : elevators.get(0);
    }

    @Override
    public String getStrategyName() { return "SCAN / LOOK (Elevator Sweep)"; }
}

