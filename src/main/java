class Floor {
    private final int floorNumber;
    private final List<Passenger> waitingPassengers = new ArrayList<>();

    public Floor(int floorNumber) { this.floorNumber = floorNumber; }
    public int getFloorNumber() { return floorNumber; }

    public synchronized void addWaitingPassenger(Passenger p) { waitingPassengers.add(p); }
    public synchronized List<Passenger> getWaitingPassengers() { return new ArrayList<>(waitingPassengers); }
    public synchronized void removeWaitingPassenger(Passenger p) { waitingPassengers.remove(p); }
}

class Building {
    private final int minFloor;
    private final int maxFloor;
    private final List<Floor> floors = new ArrayList<>();
    private final List<Elevator> elevators = new ArrayList<>();

    public Building(int minFloor, int maxFloor, int numElevators, double capacityKg) {
        this.minFloor = minFloor;
        this.maxFloor = maxFloor;

        for (int i = minFloor; i <= maxFloor; i++) {
            floors.add(new Floor(i));
        }

        for (int i = 0; i < numElevators; i++) {
            int startFloor = minFloor + (i * (maxFloor - minFloor) / Math.max(1, numElevators - 1));
            elevators.add(new Elevator(i + 1, minFloor, maxFloor, capacityKg, startFloor));
        }
    }

    public int getMinFloor() { return minFloor; }
    public int getMaxFloor() { return maxFloor; }
    public int getTotalFloors() { return maxFloor - minFloor + 1; }
    public Floor getFloor(int f) { return floors.get(f - minFloor); }
    public List<Floor> getFloors() { return floors; }
    public List<Elevator> getElevators() { return elevators; }
}

class ElevatorController {
    private final Building building;
    private SchedulingStrategy strategy;

    public ElevatorController(Building building, SchedulingStrategy initialStrategy) {
        this.building = building;
        this.strategy = initialStrategy;
    }

    public synchronized SchedulingStrategy getStrategy() { return strategy; }

    public synchronized void setStrategy(SchedulingStrategy strategy) {
        System.out.println(">> [CONTROLLER] Swapped Scheduling Strategy to: " + strategy.getStrategyName());
        this.strategy = strategy;
    }

    public synchronized Elevator dispatch(ExternalRequest req, long tick) {
        Elevator best = strategy.selectElevator(building.getElevators(), req, building.getTotalFloors());
        best.addTargetFloor(req.getSourceFloor(), tick);
        return best;
    }

    public synchronized void processBoarding(Elevator elevator, long tick) {
        if (!(elevator.getState() instanceof DoorsOpenState)) return;

        Floor floor = building.getFloor(elevator.getCurrentFloor());
        List<Passenger> waiting = floor.getWaitingPassengers();
        if (waiting.isEmpty()) return;

        Direction elevDir = elevator.getDirection();
        List<Passenger> boarded = new ArrayList<>();

        for (Passenger p : waiting) {
            boolean matchesDir = (elevDir == Direction.IDLE) || (elevDir == p.getDesiredDirection()) ||
                                 (!elevator.hasTargetsAbove() && !elevator.hasTargetsBelow());

            if (matchesDir) {
                try {
                    elevator.boardPassenger(p, tick);
                    boarded.add(p);
                    if (elevator.getDirection() == Direction.IDLE) {
                        elevator.setDirection(p.getDesiredDirection());
                    }
                } catch (OverloadException oe) {
                    System.out.println("   [!] " + oe.getMessage());
                    break; // Elevator at capacity
                }
            }
        }

        for (Passenger p : boarded) {
            floor.removeWaitingPassenger(p);
        }
    }
}

