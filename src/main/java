class InvalidFloorException extends RuntimeException {
    public InvalidFloorException(int floor, int min, int max) {
        super(String.format("Invalid floor %d requested! Permitted range: [%d, %d].", floor, min, max));
    }
}

class OverloadException extends Exception {
    public OverloadException(int elevatorId, double currentWeight, double additionalWeight, double maxCapacity) {
        super(String.format("Elevator %d OVERLOAD! Current: %.1f kg, Adding: %.1f kg, Max: %.1f kg.",
                elevatorId, currentWeight, additionalWeight, maxCapacity));
    }
}

